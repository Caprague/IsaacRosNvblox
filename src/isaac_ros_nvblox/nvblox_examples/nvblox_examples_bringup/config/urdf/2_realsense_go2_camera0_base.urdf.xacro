<robot name="2_realsense_go2_camera0_base">

  <!-- camera0_link -> sensor_head_link -> base_link      -->
  <!--                                  -> camera1_link   -->

  <link name="camera0_link"/>

  <joint name="camera0" type="fixed">
    <parent link="camera0_link"/>
    <child link="sensor_head_link"/>
    <origin xyz="0.0261373 -0.0174472 -0.0312355" rpy="0 0 0"/>
  </joint>

  <link name="sensor_head_link"/>

  <joint name="sensor_head_to_base" type="fixed">
    <parent link="sensor_head_link"/>
    <child link="base_link"/>
    <origin xyz="-0.3384235 0 -0.0792744" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="camera1" type="fixed">
    <parent link="sensor_head_link"/>
    <child link="camera1_link"/>
    <origin xyz="0.0012610 0.0174472 0.087530" rpy="0 0.785 0"/>
  </joint>

  <link name="camera1_link"/>

</robot>
